config_version=5

[application]
config/name="Britannia Reborn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/UO World Studio"
run/main_scene="res://Main.tscn"

[audio]

driver/enable_input=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=800

[shader_globals]

clearance_focus={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
clearance_eye={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
clearance_radius={
"type": "float",
"value": 0.0
}

[importer_defaults]

texture={
"compress/mode": 2
}

[rendering]
anti_aliasing/quality/msaa_3d=2
textures/default_filters/use_nearest_mipmap_filter=false
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=4096
mesh_lod/lod_change/threshold_pixels=2.0
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.035,0.055,0.08,1)
