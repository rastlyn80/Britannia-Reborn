extends RefCounted

const StarterSkin := 1058
const HornHues := [0x709, 0x70b, 0x70d, 0x70f, 0x711, 0x763, 0x765, 0x768, 0x76b,
	0x6f3, 0x6f1, 0x6ef, 0x6e4, 0x6e2, 0x6e0]
const MaleHorns := [0x4258, 0x4259, 0x425a, 0x425b, 0x425c, 0x425d, 0x425e, 0x425f]
const FemaleHorns := [0x4261, 0x4262, 0x4273, 0x4274, 0x4275, 0x42aa, 0x42ab, 0x42b1, 0x42b0]
const FacialHorns := [0x42ad, 0x42ae, 0x42af, 0x42b0]
const Cloth := {0x403: 0x301, 0x404: 0x301, 0x405: 0x304, 0x406: 0x304,
	0x407: 0x311, 0x408: 0x311, 0x409: 0x40a, 0x40a: 0x40a}

static func body(female: bool) -> int:
	return 667 if female else 666

static func horn_graphics(female: bool) -> Array:
	return FemaleHorns if female else MaleHorns

static func starter(female: bool) -> Array:
	return [{"id": 0x405 if female else 0x406, "hue": 2, "layer": 13},
		{"id": 0x409 if female else 0x40a, "hue": 3, "layer": 4}]
