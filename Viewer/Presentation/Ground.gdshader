shader_type spatial;
uniform vec2 source_origin=vec2(0.0);
render_mode cull_disabled;
#include "res://Presentation/SurfaceNoise.gdshaderinc"
uniform sampler2D stone_detail : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D stone_normal : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D shore_data : filter_linear, repeat_disable;
uniform vec4 shore_rect = vec4(0.0,0.0,1.0,1.0);
uniform bool has_shore = false;
uniform sampler2D paving_albedo : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D paving_normal : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D paving_roughness : filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec2 paving_scale=vec2(1.0);
uniform sampler2D ground_albedo : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D ground_normal : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D ground_roughness : filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec2 ground_scale=vec2(1.0);
uniform sampler2D rock_albedo : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D rock_normal : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D rock_roughness : filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec2 rock_scale=vec2(1.0);
uniform sampler2D wood_albedo : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D wood_normal : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D wood_roughness : filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec2 wood_scale=vec2(1.0);
varying vec3 world_position;
void vertex(){ world_position=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz+vec3(source_origin.x,0.0,source_origin.y); }
void fragment() {
 float broad=surface_fbm(UV*0.30);
 float detail=surface_fbm(UV*7.0);
 vec3 grass=mix(vec3(0.085,0.14,0.045),vec3(0.17,0.24,0.08),broad);
 vec3 earth=mix(vec3(0.17,0.12,0.073),vec3(0.27,0.22,0.145),broad);
 float source_grass=smoothstep(0.01,0.07,COLOR.g-COLOR.r);
 float blend_noise=(surface_noise(UV*2.7)-0.5)*0.23;
 vec3 ground=mix(earth,grass,smoothstep(0.12,0.85,source_grass+blend_noise));
 vec3 ground_tex=texture(ground_albedo,UV*ground_scale).rgb;
 ground*=mix(0.72,1.22,clamp(dot(ground_tex,vec3(0.2126,0.7152,0.0722))*2.8,0.0,1.0));
 vec2 paving=UV*vec2(3.3,4.0);
 paving.x+=mod(floor(paving.y),2.0)*0.5;
 vec2 stone_id=floor(paving);
 vec2 jitter=vec2(surface_hash(stone_id),surface_hash(stone_id+17.0))-0.5;
 vec2 local=fract(paving)-0.5+jitter*0.055;
 float rounded=length(max(abs(local)-vec2(0.34,0.30),vec2(0.0)));
 float aa=length(fwidth(paving));
 float block=1.0-smoothstep(0.105-aa,0.145+aa,rounded);
 float variation=mix(0.88,1.12,surface_hash(stone_id));
 vec3 stone=mix(vec3(0.085,0.091,0.075),vec3(0.22,0.235,0.21)*variation,block);
 vec3 paving_tex=texture(paving_albedo,UV*paving_scale).rgb;
 stone=mix(vec3(dot(paving_tex,vec3(0.2126,0.7152,0.0722))),paving_tex,0.68)*mix(0.94,1.06,broad);
 float paving_weight=smoothstep(0.08,0.9,UV2.x+(surface_fbm(UV*3.4)-0.5)*0.13);
 vec3 color=mix(ground,stone,paving_weight);
 float column=floor(UV.x*4.2);
 float plank=fract(UV.x*4.2);
 float along=UV.y/2.7+surface_hash(vec2(column,0.0))*0.85;
 float end=fract(along);
 float aa_wood=fwidth(UV.x)*4.2;
 float seam=smoothstep(0.003,0.016+aa_wood,min(plank,1.0-plank));
 seam*=smoothstep(0.002,0.010+fwidth(along),min(end,1.0-end));
 float grain=surface_fbm(UV*vec2(18.0,0.45));
 float board_tone=mix(0.92,1.08,surface_hash(vec2(column,floor(along))));
 vec3 wood=mix(vec3(0.16,0.090,0.043),vec3(0.29,0.19,0.10),grain)*mix(0.65,1.0,seam)*board_tone;
 vec3 wood_tex=texture(wood_albedo,UV*wood_scale).rgb;
 wood=mix(wood,wood_tex*vec3(0.88,0.77,0.62),0.75);
 float wood_weight=smoothstep(0.15,0.85,UV2.y);
 color=mix(color,wood,wood_weight);
 vec3 world_normal=normalize((INV_VIEW_MATRIX*vec4(NORMAL,0.0)).xyz);
 float slope=1.0-abs(world_normal.y);
 float cliff=smoothstep(0.28,0.7,slope)*(1.0-smoothstep(0.25,0.65,UV2.y));
 vec2 rock_uv=vec2(world_position.x+world_position.z,world_position.y);
 float rock=surface_fbm(rock_uv*vec2(1.8,2.4));
 float strata=surface_noise(rock_uv*vec2(0.5,7.0));
 vec3 rock_color=mix(vec3(0.18,0.17,0.135),vec3(0.32,0.30,0.245),rock)*mix(0.88,1.06,strata);
 vec3 tri_weights=pow(abs(world_normal),vec3(4.0));
 tri_weights/=max(dot(tri_weights,vec3(1.0)),0.001);
 vec3 rock_tex=texture(rock_albedo,world_position.zy*rock_scale).rgb*tri_weights.x+texture(rock_albedo,world_position.xz*rock_scale).rgb*tri_weights.y+texture(rock_albedo,world_position.xy*rock_scale).rgb*tri_weights.z;
 rock_color=mix(rock_color,rock_tex*vec3(0.98,0.96,0.86),0.82);
 float moss=smoothstep(0.48,0.78,surface_fbm(rock_uv*1.1))*smoothstep(0.15,0.55,world_normal.y);
 rock_color=mix(rock_color,grass*0.8,moss*0.35);
 color=mix(color,rock_color,cliff);
 if(has_shore){
  vec3 shore=texture(shore_data,(UV-shore_rect.xy)/shore_rect.zw).rgb;
  float near_water=1.0-smoothstep(0.25,2.0,abs(shore.r));
  float wet=(1.0-smoothstep(shore.g+0.05,shore.g+0.9,world_position.y))*near_water;
  color*=mix(1.0,0.66,wet);
  ROUGHNESS=mix(0.91,0.60,wet);
 } else { ROUGHNESS=0.91; }
 ALBEDO=color;
 vec3 base_n=texture(ground_normal,UV*ground_scale).rgb;
 vec3 paving_n=texture(paving_normal,UV*paving_scale).rgb;
 vec3 wood_n=texture(wood_normal,UV*wood_scale).rgb;
 vec2 cliff_uv=abs(world_normal.x)>abs(world_normal.z)?world_position.zy:world_position.xy;
 vec3 rock_n=texture(rock_normal,cliff_uv*rock_scale).rgb;
 NORMAL_MAP=mix(mix(mix(base_n,paving_n,paving_weight),wood_n,wood_weight),rock_n,cliff);
 NORMAL_MAP_DEPTH=0.43;
 float surface_rough=mix(texture(ground_roughness,UV*ground_scale).r,texture(paving_roughness,UV*paving_scale).r,paving_weight);
 surface_rough=mix(surface_rough,texture(wood_roughness,UV*wood_scale).r,wood_weight);
 ROUGHNESS=clamp(mix(ROUGHNESS,surface_rough,0.55),0.45,0.97);
 SPECULAR=0.22;
 AO=1.0;
}
